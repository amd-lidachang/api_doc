        <type>int</type>
        <definition>int onnx_run_inference</definition>
        <argsstring>(struct onnx_context_node onnx_context_node, const void *memory_info, const char **input_names, const int64_t **input_shapes, void **inbufs, const char **output_names, const int64_t **output_shapes, void **outbufs)</argsstring>
        <name>onnx_run_inference</name>
        <param>
          <type>struct <ref refid="structonnx__context__node" kindref="compound">onnx_context_node</ref></type>
          <declname>onnx_context_node</declname>
        </param>
        <param>
          <type>const void *</type>
          <declname>memory_info</declname>
        </param>
        <param>
          <type>const char **</type>
          <declname>input_names</declname>
        </param>
        <param>
          <type>const int64_t **</type>
          <declname>input_shapes</declname>
        </param>
        <param>
          <type>void **</type>
          <declname>inbufs</declname>
        </param>
        <param>
          <type>const char **</type>
          <declname>output_names</declname>
        </param>
        <param>
          <type>const int64_t **</type>
          <declname>output_shapes</declname>
        </param>
        <param>
          <type>void **</type>
          <declname>outbufs</declname>
        </param>
        <briefdescription>
<para>Run the model in an OrtSession. </para>
        </briefdescription>
        <detaileddescription>
<para>Input and output buffers&apos; order is defined by input_names and output_names respectively. If the latters are omitted, input and output buffers must be given in the order defined by the onnx model.</para>
<para>Input/output shapes of the buffers are optional as they are read in the onnx file. If a shape contains variable dimensions (represented by -1), the argument is required.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in"><ref refid="structonnx__context__node" kindref="compound">onnx_context_node</ref></parametername>
</parameternamelist>
<parameterdescription>
<para>Struct with OnnxRuntime session and transputs info. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">memory_info</parametername>
</parameternamelist>
<parameterdescription>
<para>OrtMemoryInfo for tensor creation. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">input_names</parametername>
</parameternamelist>
<parameterdescription>
<para>An array of the inputs names (optional). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">input_shapes</parametername>
</parameternamelist>
<parameterdescription>
<para>An array of the inputs shapes (optional). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">inbufs</parametername>
</parameternamelist>
<parameterdescription>
<para>Two-dimensional array of input values (allocated by user). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">output_names</parametername>
</parameternamelist>
<parameterdescription>
<para>An array of the outputs names (optional). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">output_shapes</parametername>
</parameternamelist>
<parameterdescription>
<para>An array of the outputs shapes (optional). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">outbufs</parametername>
</parameternamelist>
<parameterdescription>
<para>Two-dimensional array of output values (allocated by user). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>int The Vart ML error (vart_ml_error_id) code of the operation. </para>
</simplesect>
</para>
